# FieldEval Environment Configuration Template
# Copy this file to .env.local and fill in your values. Never commit real keys.

# Required: Google Gemini API key for Gemma 4 vision model inference
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Vision model ID (defaults to gemma-4-31b-it)
MODEL_ID=gemma-4-31b-it

# Optional: Vision provider adapter (defaults to gemini)
PROVIDER=gemini

# Optional: Daily rate limit ceiling (defaults to 300)
DAILY_CAP=300

# Optional: Sentry DSN for server-side inference pipeline tracing
SENTRY_DSN=
